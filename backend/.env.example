# Copie para .env e ajuste. O .env NUNCA deve ser commitado.
# Usado ao rodar a API fora do Docker (desenvolvimento). No docker-compose, as
# variáveis APP_DB_* são preenchidas a partir do .env da raiz.

APP_APP_NAME=Assistente de Manuais
# development | test | production
APP_ENVIRONMENT=development
# Origens do frontend autorizadas (separadas por vírgula), exatamente como aparecem na
# barra do navegador, sem a subpasta. Ex.: XAMPP no servidor -> http://servidor
APP_CORS_ORIGINS=http://localhost:5173,http://localhost

# Banco de dados (o do docker-compose fica em localhost:5432)
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=manuais
APP_DB_USER=manuais
APP_DB_PASSWORD=troque-esta-senha

# Autenticação
# Chave que assina as sessões (mínimo 32 caracteres). Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_AUTH_SECRET_KEY=
# Duração da sessão, em horas
APP_AUTH_SESSION_HOURS=10
# Bloqueio contra força bruta: tentativas erradas seguidas e minutos de bloqueio
APP_AUTH_MAX_FAILED_ATTEMPTS=5
APP_AUTH_LOCKOUT_MINUTES=15
# Ligue SOMENTE quando a API estiver em HTTPS (o cookie deixa de trafegar em HTTP)
APP_AUTH_COOKIE_SECURE=false

# Arquivos dos manuais (no Docker, um volume persistente)
APP_STORAGE_DIR=data/manuals
APP_MAX_UPLOAD_MB=50

# Busca e resposta
# Quantidade de trechos enviados ao modelo por pergunta.
APP_RAG_TOP_K=6
# Relevância mínima (0 a 1). 0 = sem corte: com o Gemini, trechos sem relação ainda
# pontuam ~0,6, então quem decide "não encontrei" é o modelo, seguindo o prompt.
APP_RAG_MIN_SCORE=0

# Provedor de IA: gemini | openai
# ATENÇÃO: use o plano PAGO da API. No gratuito, os dados enviados (trechos dos
# manuais) podem ser usados pelo provedor para treinar modelos.
APP_AI_PROVIDER=gemini
APP_AI_TIMEOUT_SECONDS=60
# Tentativas por chamada (repete automaticamente em erros 429/5xx de sobrecarga)
APP_AI_ATTEMPTS=4

APP_GEMINI_API_KEY=
APP_GEMINI_CHAT_MODEL=gemini-3.5-flash
# Não use o gemini-embedding-2: ele junta vários textos num só vetor (sem envio em lote).
APP_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Plano gratuito (só para testes): a cota é de ~100 trechos e ~30 mil tokens por minuto,
# e um lote de 100 trechos já passa disso. Use lotes de 20 e espere 60 s ao receber 429.
# A indexação fica lenta, e a cota diária (~1000 trechos) limita quantos manuais cabem.
# No plano pago, mantenha 100 e 0 (0 = falha na hora em vez de esperar).
APP_GEMINI_EMBEDDING_BATCH_SIZE=100
APP_GEMINI_QUOTA_WAIT_SECONDS=0
# 0 desliga o "raciocínio" (mais rápido e barato; suficiente para responder com trechos).
# Use "none" com modelos sem raciocínio (ex.: gemini-3.5-flash-lite), que recusam o parâmetro.
APP_GEMINI_THINKING_BUDGET=0

APP_OPENAI_API_KEY=
APP_OPENAI_CHAT_MODEL=gpt-4.1-mini
APP_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
